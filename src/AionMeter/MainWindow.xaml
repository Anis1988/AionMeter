<Window x:Class="AionMeter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aion Meter" Width="370" Height="300" MinWidth="320" MinHeight="44"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResizeWithGrip"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid>
        <!-- ===== Full meter ===== -->
        <Grid x:Name="Panel" Margin="6">
            <!-- Glow sits behind the content so text stays crisp -->
            <Border CornerRadius="12" Background="{StaticResource PanelGradient}">
                <!-- Cached so the glow is drawn once, not on every update -->
                <Border.CacheMode>
                    <BitmapCache />
                </Border.CacheMode>
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="18" ShadowDepth="0"
                                      Opacity="0.45" />
                </Border.Effect>
            </Border>
            <Border CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource AccentGradient}"
                    Background="{StaticResource PanelGradient}" ClipToBounds="True">
                <DockPanel>
                    <!-- Header: drag to move -->
                    <Border DockPanel.Dock="Top" Height="32" CornerRadius="11,11,0,0"
                            Background="{StaticResource HeaderGradient}"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                                        ClipToBounds="True">
                                <Image x:Name="LogoImage" Width="18" Height="18" Margin="0,0,6,0"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="AION" FontWeight="Bold" FontSize="12" Foreground="White"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="METER" FontWeight="Light" FontSize="12" Margin="3,0,0,0"
                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="HeaderInfo" Margin="8,0,0,0" FontSize="11" Foreground="#99E6EDF7"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,5,0"
                                        VerticalAlignment="Center">
                                <Button x:Name="FilterButton" Style="{StaticResource IconButton}" Content="&#xE71C;"
                                        ToolTip="Filter classes, monsters and bosses" Click="Filter_Click" />
                                <Button x:Name="PauseButton" Style="{StaticResource IconButton}" Content="&#xE769;"
                                        ToolTip="Pause" Click="Pause_Click" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE8C8;"
                                        ToolTip="Copy top players" Click="Copy_Click" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE72C;"
                                        ToolTip="Reset (start over)" Click="Reset_Click" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE8FD;"
                                        ToolTip="Full list" Click="Details_Click" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE713;"
                                        ToolTip="Settings" Click="Settings_Click" />
                                <Button x:Name="CollapseButton" Style="{StaticResource IconButton}"
                                        Content="&#xE70E;" ToolTip="Collapse to title bar" Click="Collapse_Click" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE73F;"
                                        ToolTip="Shrink to cube" Click="Cube_Click" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Close"
                                        Click="Close_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Footer -->
                    <Border x:Name="FooterBar" DockPanel.Dock="Bottom" Height="26" Background="#0DFFFFFF"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,11,11" Padding="6,0,18,0">
                        <DockPanel VerticalAlignment="Center">
                            <Button x:Name="ModeButton" DockPanel.Dock="Left" Style="{StaticResource ChipButton}"
                                    Content="DMG" Click="Mode_Click" />
                            <TextBlock x:Name="Footer" Margin="8,0,0,0" FontSize="11" Foreground="#CCE6EDF7"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>

                    <!-- Ranked bars: click for the full list -->
                    <Grid x:Name="Body">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                            <ItemsControl x:Name="Bars" Margin="6,5,6,5" Background="Transparent" Cursor="Hand"
                                          ToolTip="Click for the full list"
                                          MouseLeftButtonUp="Bars_MouseLeftButtonUp">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="28" Margin="0,2">
                                            <Border CornerRadius="6" Background="#0EFFFFFF" />
                                            <Border CornerRadius="6" Background="{Binding ClassBrush}"
                                                    RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding BarFraction}" />
                                                </Border.RenderTransform>
                                            </Border>
                                            <Border CornerRadius="6" BorderThickness="1"
                                                    BorderBrush="{StaticResource AccentBrush}"
                                                    Visibility="{Binding YouVisibility}" />
                                            <Grid Margin="4,0,8,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Rank}" Foreground="#B3E6EDF7"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                                           HorizontalAlignment="Center" />
                                                <Image Grid.Column="1" Source="{Binding Icon}" Width="22" Height="22"
                                                       Margin="2,0,7,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Grid.Column="2" Text="{Binding Name}"
                                                           Foreground="{Binding NameBrush}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding ValueText}" Foreground="White"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Margin="6,0,0,0" />
                                                <TextBlock Grid.Column="4" Text="{Binding PerSecondText}"
                                                           Foreground="#CCE6EDF7" FontSize="11"
                                                           VerticalAlignment="Center" Margin="6,0,0,0" />
                                                <TextBlock Grid.Column="5" Text="{Binding PercentShort}"
                                                           Foreground="{StaticResource AccentBrush}" FontSize="11"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="EmptyText" Text="Waiting for combat..." Foreground="#80E6EDF7"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Filter popup -->
            <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterButton}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border x:Name="FilterHost" Width="250" Padding="8" Margin="0,4,0,0" CornerRadius="10"
                        Background="#F20E1420" BorderBrush="{StaticResource AccentGradient}" BorderThickness="1" />
            </Popup>
        </Grid>

        <!-- ===== Tiny cube: click to restore, drag to move ===== -->
        <Grid x:Name="Cube" Width="56" Height="56" Margin="6" Visibility="Collapsed" Cursor="Hand"
              ToolTip="Click to restore, drag to move" MouseLeftButtonDown="Cube_MouseLeftButtonDown">
            <Border CornerRadius="12" Background="{StaticResource PanelGradient}">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="16" ShadowDepth="0"
                                      Opacity="0.6" />
                </Border.Effect>
            </Border>
            <Border CornerRadius="12" BorderThickness="1.5" BorderBrush="{StaticResource AccentGradient}">
                <StackPanel VerticalAlignment="Center">
                    <Image x:Name="CubeLogo" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="CubeText" HorizontalAlignment="Center" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
