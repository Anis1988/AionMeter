<Window x:Class="AionMeter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="app.ico"
        Title="Aion Meter" Width="390" Height="300" MinWidth="350" MinHeight="120"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResizeWithGrip"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid>
        <!-- ===== Full meter ===== -->
        <Grid x:Name="Panel" Margin="6">
            <!-- Glow sits behind the content so text stays crisp -->
            <Border CornerRadius="12" Background="{StaticResource PanelGradient}">
                <!-- Cached so the glow is drawn once, not on every update -->
                <Border.CacheMode>
                    <BitmapCache />
                </Border.CacheMode>
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="18" ShadowDepth="0"
                                      Opacity="0.45" />
                </Border.Effect>
            </Border>
            <Border CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource AccentGradient}"
                    Background="{StaticResource PanelGradient}" ClipToBounds="True">
                <DockPanel>
                    <!-- Header: drag to move; the logo shrinks the meter to the cube -->
                    <Border DockPanel.Dock="Top" Height="38" CornerRadius="11,11,0,0"
                            Background="{StaticResource HeaderGradient}"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0,0,0"
                                        ClipToBounds="True">
                                <Button Style="{StaticResource LogoButton}" ToolTip="Shrink to cube"
                                        Click="Cube_Click">
                                    <Image x:Name="LogoImage" Width="18" Height="18"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Button>
                                <TextBlock Text="AION" FontWeight="Bold" FontSize="13" Foreground="White"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="METER" FontWeight="Light" FontSize="13" Margin="3,0,0,0"
                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <Border x:Name="TimerChip" Margin="9,0,0,0" Padding="7,1" CornerRadius="8"
                                        Background="#1AFFFFFF" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="HeaderInfo" FontSize="10.5" Foreground="#CCE6EDF7" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,4,0"
                                        VerticalAlignment="Center">
                                <Button x:Name="PauseButton" Style="{StaticResource ColorIconButton}" Content="&#xE769;"
                                        Foreground="{StaticResource PauseColor}" ToolTip="Pause" Click="Pause_Click" />
                                <Button Style="{StaticResource ColorIconButton}" Content="&#xE8C8;"
                                        Foreground="{StaticResource CopyColor}" ToolTip="Copy top players"
                                        Click="Copy_Click" />
                                <Button Style="{StaticResource ColorIconButton}" Content="&#xE72C;"
                                        Foreground="{StaticResource ResetColor}" ToolTip="Reset (start over)"
                                        Click="Reset_Click" />
                                <Rectangle Width="1" Height="20" Margin="4,0" Fill="#33FFFFFF" />
                                <Button Style="{StaticResource ColorIconButton}" Content="&#xE8BB;" FontSize="12.5"
                                        Foreground="{StaticResource CloseColor}" ToolTip="Close" Click="Close_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- Thin accent line under the header -->
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource AccentGradient}"
                            Opacity="0.45" />

                    <!-- Pick a target and/or a class to rank -->
                    <Grid x:Name="PickBar" DockPanel.Dock="Top" Margin="8,6,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="TargetBox" Style="{StaticResource DarkCombo}"
                                  ItemTemplate="{StaticResource PickTemplate}"
                                  ToolTip="Rank everyone's damage on one mob, boss or player"
                                  SelectionChanged="Pick_SelectionChanged" />
                        <ComboBox x:Name="ClassPickBox" Grid.Column="2" Style="{StaticResource DarkCombo}"
                                  ItemTemplate="{StaticResource PickTemplate}"
                                  ToolTip="Rank only one class" SelectionChanged="Pick_SelectionChanged" />
                    </Grid>

                    <!-- Footer: mode switch, totals, settings (left of the resize grip) -->
                    <Border x:Name="FooterBar" DockPanel.Dock="Bottom" Height="36" Background="#0DFFFFFF"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,11,11" Padding="7,0,16,0">
                        <DockPanel VerticalAlignment="Center">
                            <Button x:Name="ModeButton" DockPanel.Dock="Left" Style="{StaticResource ChipButton}"
                                    Content="DMG" Click="Mode_Click" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource ColorIconButton}" Content="&#xE713;"
                                    Height="28" Width="38" Foreground="{StaticResource SettingsColor}"
                                    ToolTip="Settings" Click="Settings_Click" />
                            <TextBlock x:Name="Footer" Margin="8,0,4,0" FontSize="11" Foreground="#CCE6EDF7"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>

                    <!-- Ranked bars: click for the full list -->
                    <Grid x:Name="Body">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                            <ItemsControl x:Name="Bars" Margin="6,5,6,5" Background="Transparent" Cursor="Hand"
                                          ToolTip="Click for the full list"
                                          MouseLeftButtonUp="Bars_MouseLeftButtonUp">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="28" Margin="0,2">
                                            <Border CornerRadius="7" Background="#0EFFFFFF" BorderBrush="#0FFFFFFF" BorderThickness="1" />
                                            <Border CornerRadius="7" Background="{Binding ClassBrush}"
                                                    RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding BarFraction}" />
                                                </Border.RenderTransform>
                                            </Border>
                                            <Border CornerRadius="7" BorderThickness="1"
                                                    BorderBrush="{StaticResource AccentBrush}"
                                                    Visibility="{Binding YouVisibility}" />
                                            <Grid Margin="4,0,8,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Rank}" Foreground="{Binding RankBrush}"
                                                           FontWeight="Bold" VerticalAlignment="Center"
                                                           HorizontalAlignment="Center" />
                                                <Image Grid.Column="1" Source="{Binding Icon}" Width="22" Height="22"
                                                       Margin="2,0,7,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Grid.Column="2" Text="{Binding Name}"
                                                           Foreground="{Binding NameBrush}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding ValueText}" Foreground="White"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Margin="6,0,0,0" />
                                                <TextBlock Grid.Column="4" Text="{Binding PerSecondText}"
                                                           Foreground="#CCE6EDF7" FontSize="11"
                                                           VerticalAlignment="Center" Margin="6,0,0,0" />
                                                <TextBlock Grid.Column="5" Text="{Binding PercentShort}"
                                                           Foreground="{StaticResource AccentBrush}" FontSize="11"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="EmptyText" Text="Waiting for combat..." Foreground="#80E6EDF7"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </DockPanel>
            </Border>

        </Grid>

        <!-- ===== Tiny cube: click to restore, drag to move ===== -->
        <Grid x:Name="Cube" Width="56" Height="56" Margin="6" Visibility="Collapsed" Cursor="Hand"
              ToolTip="Click to restore, drag to move" MouseLeftButtonDown="Cube_MouseLeftButtonDown">
            <Border CornerRadius="12" Background="{StaticResource PanelGradient}">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="16" ShadowDepth="0"
                                      Opacity="0.6" />
                </Border.Effect>
            </Border>
            <Border CornerRadius="12" BorderThickness="1.5" BorderBrush="{StaticResource AccentGradient}">
                <StackPanel VerticalAlignment="Center">
                    <Image x:Name="CubeLogo" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="CubeText" HorizontalAlignment="Center" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
