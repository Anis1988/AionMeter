<Window x:Class="AionMeter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aion Meter" Width="330" Height="280" MinWidth="230" MinHeight="120"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResizeWithGrip" FontFamily="Segoe UI" FontSize="12">
    <Border CornerRadius="6" Background="#E6121419" BorderBrush="#40FFFFFF" BorderThickness="1">
        <DockPanel>
            <!-- Header: drag to move -->
            <Grid DockPanel.Dock="Top" Height="28" Background="#22FFFFFF"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="AION METER" FontWeight="Bold" FontSize="11"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="HeaderInfo" Margin="8,0,0,0" FontSize="11" Foreground="#B0FFFFFF"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="PauseButton" Style="{StaticResource IconButton}" Content="&#xE769;"
                            ToolTip="Pause" Click="Pause_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;"
                            ToolTip="Copy everyone's damage" Click="Copy_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Reset (start over)"
                            Click="Reset_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8FD;" ToolTip="Full list"
                            Click="Details_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings"
                            Click="Settings_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Close"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Border DockPanel.Dock="Bottom" Height="22" Background="#18FFFFFF" Padding="8,0,18,0">
                <TextBlock x:Name="Footer" VerticalAlignment="Center" FontSize="11" Foreground="#B0FFFFFF"
                           TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- Ranked bars: click for the full list -->
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="Bars" Margin="3,3,3,3" Background="Transparent" Cursor="Hand"
                                  ToolTip="Click for the full list" MouseLeftButtonUp="Bars_MouseLeftButtonUp">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="24" Margin="0,1">
                                    <Border Background="#14FFFFFF" CornerRadius="3" />
                                    <Border Background="{Binding ClassBrush}" Opacity="0.55" CornerRadius="3"
                                            RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding BarFraction}" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                            CornerRadius="3" Visibility="{Binding YouVisibility}" />
                                    <Grid Margin="4,0,6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Rank}" Foreground="#C8FFFFFF"
                                                   VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <Image Grid.Column="1" Source="{Binding Icon}" Width="18" Height="18"
                                               Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="White"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Summary}" Foreground="White"
                                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" Text="Waiting for combat..." Foreground="#80FFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
        </DockPanel>
    </Border>
</Window>
