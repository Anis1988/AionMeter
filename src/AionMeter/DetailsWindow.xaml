<Window x:Class="AionMeter.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aion Meter - All players" Width="940" Height="580" MinWidth="520" MinHeight="360"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="12" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ModeBox" Width="100" Margin="0,0,12,0" SelectionChanged="ModeBox_SelectionChanged">
                <ComboBoxItem Content="Damage" />
                <ComboBoxItem Content="Healing" />
            </ComboBox>
            <Button x:Name="CopyButton" Grid.Column="1" Content="Copy all" Style="{StaticResource DarkButton}"
                    ToolTip="Copy everyone's damage to the clipboard" Click="Copy_Click" />
            <Border x:Name="FilterHost" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" />
            <TextBlock x:Name="SummaryText" Grid.Row="1" Grid.ColumnSpan="4" Margin="0,8,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" FontFamily="{StaticResource UiFont}" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"
                   Text="Tip: right-click a player to set their class (or mark a boss that shows up as a player). Monsters are only in the target dropdown on the meter." />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="120" />
                <RowDefinition Height="6" />
                <RowDefinition Height="2*" MinHeight="90" />
            </Grid.RowDefinitions>

            <DataGrid x:Name="PlayersGrid" SelectionChanged="PlayersGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="36" />
                    <DataGridTemplateColumn Header="" Width="30" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Icon}" Width="22" Height="22"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding NameBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="100" />
                    <DataGridTextColumn Header="Damage" Binding="{Binding DamageText}" SortMemberPath="Damage"
                                        Width="90" ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="DPS" Binding="{Binding DpsText}" SortMemberPath="Dps"
                                        Width="80" ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="%" Binding="{Binding PercentText}" SortMemberPath="Percent"
                                        Width="64" ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="Hits" Binding="{Binding Hits}" Width="56"
                                        ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="Crit" Binding="{Binding CritText}" SortMemberPath="CritRate"
                                        Width="64" ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="Max hit" Binding="{Binding MaxHitText}" SortMemberPath="MaxHit"
                                        Width="80" ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="Healing" Binding="{Binding HealingText}" SortMemberPath="Healing"
                                        Width="90" ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="HPS" Binding="{Binding HpsText}" SortMemberPath="Hps"
                                        Width="70" ElementStyle="{StaticResource RightCell}" />
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu x:Name="RowMenu" Opened="RowMenu_Opened" />
                </DataGrid.ContextMenu>
            </DataGrid>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <DockPanel Grid.Row="2">
                <TextBlock x:Name="SkillsTitle" DockPanel.Dock="Top" Margin="0,0,0,4" FontWeight="SemiBold"
                           Text="Select a player to see their skills" />
                <DataGrid x:Name="SkillsGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Skill" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Amount" Binding="{Binding DamageText}" SortMemberPath="Damage"
                                            Width="90" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="%" Binding="{Binding PercentText}" SortMemberPath="Percent"
                                            Width="64" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="Hits" Binding="{Binding Hits}" Width="56"
                                            ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="Crit" Binding="{Binding CritText}" SortMemberPath="CritRate"
                                            Width="64" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="Average" Binding="{Binding AverageText}" SortMemberPath="Average"
                                            Width="80" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="Max hit" Binding="{Binding MaxHitText}" SortMemberPath="MaxHit"
                                            Width="80" ElementStyle="{StaticResource RightCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
