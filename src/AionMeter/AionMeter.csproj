<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>AionMeter</RootNamespace>
    <AssemblyName>AionMeter</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Aion Meter</Product>
    <Description>Chat.log based DPS meter for Aion 4.8</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AionMeter.Core\AionMeter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Icons\README.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
